# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/master/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Mm]emoryCaptures/
/[Ss]napshotCaptures/ # Added: For Unity's Profiler
/[Rr]esults/ # Added: For Unity Test Runner results

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/ # Already there, but placing it with VS related files for clarity
*.jdbg # Added: Java debugger files (Android builds)

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# Gradle files
.gradle/ # Already there
build/ # Added: Common Android build output directory
gradle/ # Added: Gradle wrapper directory (if not part of the project itself)
*.jar # Added: Java archives, often build artifacts
*.war # Added: Web application archives, often build artifacts

# Visual Studio Code (VS Code) files
.vscode/ # Added: VS Code settings and cache

# OSX files
.DS_Store # Added: macOS specific folder attributes
.Spotlight-V100 # Added: macOS Spotlight indexing
.Trashes # Added: macOS trash
__MACOSX/ # Added: macOS archive metadata

# Windows files
Thumbs.db # Added: Windows thumbnail cache
Desktop.ini # Added: Windows desktop configuration
$RECYCLE.BIN/ # Added: Windows Recycle Bin

# Builds
*.apk
*.unitypackage
*.app # Added: macOS application bundles
*.ipa # Added: iOS application archives
*.xap # Added: Windows Phone application package
*.exe # Added: Windows executable
*.dll # Added: Dynamic Link Libraries (often build output)
*.so # Added: Shared Objects (Linux/Android libraries)
*.dylib # Added: Dynamic Libraries (macOS)
*.gitignore.meta # Added: Meta file for the gitignore itself (Unity quirk)

# Local History for text editors
.localhistory/ # Added: Some editors like VS Code might use this

# Package Manager files
# These are generally tracked, but some specific patterns might be added if issues arise
# e.g., if you have local packages that shouldn't be committed, though that's rare.
# packages-lock.json and manifest.json are usually committed.

# ReSharper / dotCover / dotPeek / etc.
*.DotSettings
*.DotSettings.user

# Rider
.idea/ # Added: Rider project configuration

# Compilation output
bin/ # Added: Common output directory for compiled binaries
obj/ # Already present, but often used by compilers

# Testing
NUnit/ # Added: NUnit test results or cache

# Localization
Localization~/ # Added: Unity Localization package temporary files